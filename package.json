{
  "name": "kacosmetology-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tsconfig.playwright.json --noEmit",
    "build": "pnpm typecheck && pnpm typecheck:e2e && pnpm check:production-data && pnpm check:public-metadata && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && pnpm check:production-data && pnpm check:public-metadata",
    "check:ci": "biome ci",
    "validate:ci": "pnpm check:ci && pnpm build && pnpm test:coverage && pnpm audit --audit-level high && pnpm test:e2e",
    "validate": "pnpm run check && pnpm run build && pnpm run test:coverage && pnpm audit --audit-level high && pnpm run test:e2e",
    "format:write": "biome format --write",
    "check:write": "biome check --write",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-vitruvian": "node scripts/optimize-vitruvian.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "generate-public-metadata": "node scripts/generate-public-metadata.mjs",
    "check:public-metadata": "node scripts/generate-public-metadata.mjs --check",
    "check:production-data": "node scripts/check-production-data.mjs"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@plausible-analytics/tracker": "^0.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.10",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": "24.x"
  }
}
