{
  "name": "kacosmetology-start",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && pnpm check:public-metadata && vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && pnpm check:public-metadata",
    "validate": "pnpm run check && pnpm run build && pnpm run test:coverage && pnpm audit --audit-level high && pnpm run test:e2e",
    "format:write": "biome format --write",
    "check:write": "biome check --write",
    "optimize-images": "node scripts/optimize-images.mjs",
    "optimize-vitruvian": "node scripts/optimize-vitruvian.mjs",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "generate-public-metadata": "node scripts/generate-public-metadata.mjs",
    "check:public-metadata": "node scripts/generate-public-metadata.mjs --check"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.2.7",
    "@fontsource/playfair-display": "^5.2.8",
    "@plausible-analytics/tracker": "^0.4.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.20",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.4",
    "@playwright/test": "^1.61.1",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-devtools": "0.10.8",
    "@tanstack/router-cli": "^1.167.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engines": {
    "node": "24.x"
  }
}
