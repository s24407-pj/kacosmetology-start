# Analytics pixel IDs (client). Leave empty to keep the adapter inactive.
# Cookieless Plausible is always registered from brand.siteUrl (self-hosted).
# GA / Meta / OpenAI load only after analytics.updateConsent(...) from the cookie banner.

VITE_GA_ID=
VITE_META_PIXEL_ID=
VITE_OPENAI_PIXEL_ID=

# Public build-time settings. Empty company keeps the booking contact fallback.
VITE_SCHEDULER_COMPANY_ID=
VITE_SCHEDULER_SERVICE_MAP={}

# Server-only runtime origin for the development/integration Nitro relay.
# Production /api goes directly from the trusted edge to Spring; see
# docs/BOOKING_EDGE.md. This variable does not configure the edge route.
SCHEDULER_API_ORIGIN=http://127.0.0.1:8080
